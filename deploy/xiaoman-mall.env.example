# =============================================================================
# XiaoMan Mall — production environment file (example)
#
# WHAT THIS FILE IS
#   Template for /etc/xiaoman-mall.env. systemd reads it through
#   EnvironmentFile= in deploy/xiaoman-mall.service. It contains runtime
#   settings only; no build step and no npm dependencies are involved.
#
# 这个文件是干什么的
#   小满商城后端的生产环境变量模板。复制到 /etc/xiaoman-mall.env 后按服务器
#   实际情况修改；systemd 启动服务时读取它。
#
# 安装
#   sudo install -m 600 -o root -g root deploy/xiaoman-mall.env.example /etc/xiaoman-mall.env
#   sudo vi /etc/xiaoman-mall.env
#   sudo systemctl restart xiaoman-mall
#
# 安全
#   - 这个文件可能有 API Key，只能放在服务器上，权限必须是 root:root 600。
#   - 不要提交到 Git，不要贴到聊天/工单/截图里。
#   - 仓库里只保留不含真实密钥的 .env.example。
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP 服务
# -----------------------------------------------------------------------------
# 后端监听端口。改了这里，Nginx 的 upstream 也要同步改。
PORT=3000

# 只监听本机回环地址，公网流量统一走 Nginx。
# 如果不用 Nginx、要让容器/其他机器直连，才改成 0.0.0.0（并自行加防火墙）。
HOST=127.0.0.1

# 数据目录：商品/分类 JSON 要预先放进去；购物车、订单、用户、会话由程序写入。
# systemd 的 StateDirectory=xiaoman-mall 会创建 /var/lib/xiaoman-mall 并 chown 给 xiaoman。
XM_DATA_DIR=/var/lib/xiaoman-mall

# AI 助手调用轨迹（JSONL）。可选；不写时默认落在 server/data/agent-traces.jsonl。
# 放在数据目录里，升级代码不会把它覆盖掉。
XM_TRACE_FILE=/var/lib/xiaoman-mall/agent-traces.jsonl

# -----------------------------------------------------------------------------
# AI 助手
# -----------------------------------------------------------------------------
# local = 只用本地规则引擎，不调用外部大模型，不需要 API Key（推荐先这样上线）。
# llm   = 调用 OpenAI 兼容接口；必须同时配置 AGENT_API_KEY，否则会自动退回本地规则。
AGENT_MODE=local

# 大模型 API Key。只填在服务器上的 /etc/xiaoman-mall.env，不要提交到仓库。
# 留空表示不启用大模型；AGENT_MODE=local 时留空即可。
AGENT_API_KEY=

# OpenAI 兼容接口地址。默认 DeepSeek；换供应商时改这里。
# 末尾不要带 /chat/completions，程序会自己补。
AGENT_BASE_URL=https://api.deepseek.com/v1

# 模型名。DeepSeek 常用 deepseek-chat；换供应商时填对方文档里的模型 ID。
AGENT_MODEL=deepseek-chat

# 单次大模型请求超时（毫秒），默认 30000。网络慢时可调到 60000。
AGENT_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# 说明
# -----------------------------------------------------------------------------
# 1. systemd EnvironmentFile 的格式是 KEY=value，一行一个；不要写 export。
# 2. 值里如果包含空格或 #，用双引号包起来，例如 AGENT_MODEL="some model"。
# 3. 改完执行 sudo systemctl restart xiaoman-mall，然后用 /api/health 的 mode 字段确认。
#    不要用 systemctl show -p Environment 排查：它会把 AGENT_API_KEY 明文打印出来。
# 4. AGENT_MODE=llm 但 Key 无效时，/api/agent/chat 会走本地规则或返回错误；
#    上线前先用一条真实消息验证，不要只看进程是否启动。