# =============================================================================
# XiaoMan Mall — systemd service unit
#
# WHAT THIS FILE IS
#   Runs the XiaoMan Mall Node.js server as an unprivileged, hardened systemd
#   service. It reads runtime settings from /etc/xiaoman-mall.env, writes data
#   under /var/lib/xiaoman-mall, and restarts automatically after a crash.
#
# 这个文件是干什么的
#   把小满商城后端交给 systemd 托管：非 root 用户运行、开机自启、崩溃自动拉起、
#   日志进 journald，并用 ProtectSystem / NoNewPrivileges 等选项收紧权限。
#
# 安装
#   sudo cp deploy/xiaoman-mall.service /etc/systemd/system/xiaoman-mall.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xiaoman-mall
#   systemctl status xiaoman-mall
#
# 注意
#   - 代码目录按 /opt/xiaoman-mall/xiaoman-mall 写；换路径要同步改 WorkingDirectory。
#   - ExecStart 里的 node 路径按 NodeSource 安装的 /usr/bin/node 写；
#     用 nvm/其它方式安装时，改成 command -v node 的结果。
#   - 环境变量文件必须是 root:root 600，里面可能有 AGENT_API_KEY。
# =============================================================================

[Unit]
Description=XiaoMan Mall (小满商城) Node.js server
Documentation=file:/opt/xiaoman-mall/xiaoman-mall/docs/部署-服务器与域名.md
After=network-online.target
Wants=network-online.target

# 反复崩溃时不要无限刷重启：60 秒内超过 5 次就停下来等人工处理。
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

# 非 root 运行。用户和组由部署文档里的 useradd 创建。
User=xiaoman
Group=xiaoman
UMask=0027
WorkingDirectory=/opt/xiaoman-mall/xiaoman-mall

# 所有可配置项放这里，文件权限 root:root 600。
# 文件不存在时 systemd 会直接启动失败，这是有意的：宁可起不来，也不要裸奔。
EnvironmentFile=/etc/xiaoman-mall.env
Environment=NODE_ENV=production
Environment=XM_TRACE_FILE=/var/lib/xiaoman-mall/agent-traces.jsonl

# 不要用 node 这种相对命令：systemd 不查 PATH，必须写绝对路径。
# 如果 node 不在 /usr/bin/node，用 command -v node 查出来后改这一行。
ExecStart=/usr/bin/node server/index-服务入口.js

# 应用自己处理 SIGTERM：先停止接新请求，等在途请求结束再退出。
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=15
Restart=always
RestartSec=3

# 日志统一进 journald：journalctl -u xiaoman-mall -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xiaoman-mall

# 数据目录：systemd 负责创建并 chown 给 xiaoman，重启/升级不会丢。
StateDirectory=xiaoman-mall
StateDirectoryMode=0750

# -----------------------------------------------------------------------------
# 权限加固
# -----------------------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true

# 只允许 IPv4/IPv6/Unix 套接字；Node 解析 DNS、连本机/上游都够用。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true

# 不需要任何 Linux capability；监听 3000 端口也不需要。
CapabilityBoundingSet=
AmbientCapabilities=

# 只允许常规服务类系统调用。老内核/老 systemd 上如果启动报 permission denied，
# 先注释这一行和下一行定位，不要直接删掉整套加固。
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# ProtectSystem=strict 会把 / 挂成只读；应用只允许写数据目录和 /tmp。
# StateDirectory 已经自动包含，这里再显式写一次，方便阅读和以后加目录。
ReadWritePaths=/var/lib/xiaoman-mall

# V8 需要 JIT 写可执行内存，MemoryDenyWriteExecute 会导致 Node 起不来，
# 所以这里保持注释，不要打开。
# MemoryDenyWriteExecute=true

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target