{
  "version": 1,
  "name": "小满商城 AI 购物助手评测集",
  "description": "覆盖 9.1 对话、9.2 searchProducts 工具、9.3 多轮约束、9.4 写操作、9.5 多步规划、9.6 歧义/拒答/注入/异常、9.7 流式与会话恢复的端到端用例。",
  "groups": [
    {
      "id": "9.1",
      "title": "对话与商品问答"
    },
    {
      "id": "9.2",
      "title": "searchProducts 工具"
    },
    {
      "id": "9.3",
      "title": "多轮对话与约束"
    },
    {
      "id": "9.4",
      "title": "写操作与确认"
    },
    {
      "id": "9.5",
      "title": "多步规划与约束冲突"
    },
    {
      "id": "9.6",
      "title": "歧义、拒答与异常"
    },
    {
      "id": "9.7",
      "title": "流式输出与会话恢复"
    }
  ],
  "cases": [
    {
      "id": "c01",
      "group": "9.1",
      "title": "问候与身份",
      "purpose": "确认助手能识别问候并给出商城语境下的开场白，不误调工具。",
      "tags": [
        "dialogue"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "你好",
          "expect": {
            "tools": [],
            "replyContains": [
              "小满",
              "购物助手"
            ],
            "replyRegex": "想找点什么|300\\s*元以内的耳机",
            "deltasMin": 1
          }
        }
      ]
    },
    {
      "id": "c02",
      "group": "9.1",
      "title": "能力介绍",
      "purpose": "确认助手能说明找商品、加购、查订单等边界能力。",
      "tags": [
        "dialogue"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "你能做什么",
          "expect": {
            "tools": [],
            "replyContains": [
              "找商品",
              "查订单"
            ],
            "replyRegex": "加购|加购物车",
            "deltasMin": 1
          }
        }
      ]
    },
    {
      "id": "c03",
      "group": "9.1",
      "title": "致谢",
      "purpose": "确认寒暄不会触发商品搜索或写操作。",
      "tags": [
        "dialogue"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "谢谢你",
          "expect": {
            "tools": [],
            "replyContains": [
              "不客气"
            ],
            "deltasMin": 1
          }
        }
      ]
    },
    {
      "id": "c04",
      "group": "9.1",
      "title": "商品卖点追问",
      "purpose": "用户点名商品问卖点，应使用 get_product 读取详情并基于详情回答。",
      "tags": [
        "dialogue",
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "听风 Air One 有什么卖点",
          "expect": {
            "tools": [
              "get_product"
            ],
            "toolArgs": {
              "get_product": {
                "productId": {
                  "$eq": "p01"
                }
              }
            },
            "replyRegex": "跑步|IPX5|耳挂|运动",
            "products": {
              "minCount": 1,
              "idsInclude": [
                "p01"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "c05",
      "group": "9.2",
      "title": "价格上限搜索",
      "purpose": "验证“300 元以内的耳机”能正确拆出关键词与最高价，并返回符合预算的商品。",
      "tags": [
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "300元以内的耳机",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "耳机"
                },
                "maxPrice": {
                  "$eq": 300
                }
              }
            },
            "products": {
              "minCount": 1,
              "idsInclude": [
                "p01"
              ],
              "allPrice": {
                "$lte": 300
              }
            },
            "replyContains": [
              "找到"
            ]
          }
        }
      ]
    },
    {
      "id": "c06",
      "group": "9.2",
      "title": "键盘预算搜索",
      "purpose": "验证另一品类与价格上限的参数补全，避免只对耳机生效。",
      "tags": [
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "500元以内的键盘",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "键盘"
                },
                "maxPrice": {
                  "$eq": 500
                }
              }
            },
            "products": {
              "minCount": 1,
              "idsInclude": [
                "p06"
              ],
              "allPrice": {
                "$lte": 500
              }
            },
            "replyContains": [
              "找到"
            ]
          }
        }
      ]
    },
    {
      "id": "c07",
      "group": "9.2",
      "title": "按分类浏览",
      "purpose": "“家居分类有什么”应使用 category 过滤，而不是把“家居分类”当关键词。",
      "tags": [
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "家居分类有什么",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "category": {
                  "$oneOf": [
                    "家居",
                    "home"
                  ]
                },
                "keyword": {
                  "$oneOf": [
                    "",
                    "家居"
                  ]
                }
              }
            },
            "products": {
              "minCount": 1,
              "allCategory": "家居"
            },
            "replyContains": [
              "家居"
            ]
          }
        }
      ]
    },
    {
      "id": "c08",
      "group": "9.2",
      "title": "带修饰词的最便宜搜索",
      "purpose": "“最便宜的降噪耳机”必须同时保留“降噪”关键词与价格升序，不能退化成全站最低价。",
      "tags": [
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "最便宜的降噪耳机",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "降噪"
                },
                "sort": {
                  "$eq": "price-asc"
                }
              }
            },
            "products": {
              "minCount": 1,
              "firstId": "p04",
              "allNamesContain": "降噪"
            },
            "replyContains": [
              "便宜"
            ]
          }
        }
      ]
    },
    {
      "id": "c09",
      "group": "9.2",
      "title": "价格区间搜索",
      "purpose": "“500 到 800 元的耳机”应把区间放进 minPrice/maxPrice，关键词里不能残留价格数字。",
      "tags": [
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "500到800元的耳机",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "耳机",
                  "$notIncludes": "500"
                },
                "minPrice": {
                  "$eq": 500
                },
                "maxPrice": {
                  "$eq": 800
                }
              }
            },
            "products": {
              "minCount": 1,
              "idsInclude": [
                "p02"
              ],
              "allPrice": {
                "$gte": 500,
                "$lte": 800
              }
            },
            "replyContains": [
              "找到"
            ]
          }
        }
      ]
    },
    {
      "id": "c10",
      "group": "9.3",
      "title": "便宜一点的相对约束",
      "purpose": "第二轮“便宜一点”必须参照上一轮第一件的价格，并且保留上一轮的键盘关键词。",
      "tags": [
        "multi-turn"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "500元以内的键盘",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "键盘"
                },
                "maxPrice": {
                  "$eq": 500
                }
              }
            },
            "products": {
              "minCount": 1,
              "firstId": "p05"
            }
          }
        },
        {
          "type": "chat",
          "message": "便宜一点",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "键盘"
                },
                "maxPrice": {
                  "$lt": 449,
                  "$gte": 0
                }
              }
            },
            "products": {
              "minCount": 1,
              "allPrice": {
                "$lt": 449
              }
            },
            "replyContains": [
              "上限",
              "448"
            ]
          }
        }
      ]
    },
    {
      "id": "c11",
      "group": "9.3",
      "title": "序号指代加购",
      "purpose": "第二轮“把第二个加入购物车”应解析为上一轮搜索结果中的第二件（p02）。",
      "tags": [
        "multi-turn",
        "write"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "推荐耳机",
          "expect": {
            "tools": [
              "search_products"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "耳机"
                }
              }
            },
            "products": {
              "minCount": 2
            }
          }
        },
        {
          "type": "chat",
          "message": "把第二个加入购物车",
          "expect": {
            "tools": [
              "add_to_cart"
            ],
            "toolArgs": {
              "add_to_cart": {
                "productId": {
                  "$eq": "p02"
                },
                "quantity": {
                  "$eq": 1
                }
              }
            },
            "cart": {
              "quantity": 1,
              "amount": 699,
              "items": [
                {
                  "productId": "p02",
                  "quantity": 1
                }
              ]
            },
            "replyContains": [
              "Studio",
              "699"
            ]
          }
        }
      ]
    },
    {
      "id": "c12",
      "group": "9.3",
      "title": "多轮改数量",
      "purpose": "先加购第一件，再用“把第一个改成 2 件”修改数量，购物车金额同步为两件。",
      "tags": [
        "multi-turn",
        "write"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "推荐耳机",
          "expect": {
            "tools": [
              "search_products"
            ],
            "products": {
              "minCount": 2
            }
          }
        },
        {
          "type": "chat",
          "message": "把第一个加入购物车",
          "expect": {
            "tools": [
              "add_to_cart"
            ],
            "toolArgs": {
              "add_to_cart": {
                "productId": {
                  "$eq": "p01"
                },
                "quantity": {
                  "$eq": 1
                }
              }
            },
            "cart": {
              "quantity": 1,
              "amount": 299,
              "items": [
                {
                  "productId": "p01",
                  "quantity": 1
                }
              ]
            }
          }
        },
        {
          "type": "chat",
          "message": "把第一个改成 2 件",
          "expect": {
            "tools": [
              "update_cart_quantity"
            ],
            "toolArgs": {
              "update_cart_quantity": {
                "productId": {
                  "$eq": "p01"
                },
                "quantity": {
                  "$eq": 2
                }
              }
            },
            "cart": {
              "quantity": 2,
              "amount": 598,
              "items": [
                {
                  "productId": "p01",
                  "quantity": 2
                }
              ]
            },
            "replyContains": [
              "改成 2 件",
              "598"
            ]
          }
        }
      ]
    },
    {
      "id": "c13",
      "group": "9.3",
      "title": "指代追问价格",
      "purpose": "第二轮“这个多少钱”应指向上轮第一件 p01，并用 get_product 查询后回答 299。",
      "tags": [
        "multi-turn",
        "tool-use"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "300元以内的耳机",
          "expect": {
            "tools": [
              "search_products"
            ],
            "products": {
              "minCount": 1,
              "idsInclude": [
                "p01"
              ]
            }
          }
        },
        {
          "type": "chat",
          "message": "这个多少钱",
          "expect": {
            "tools": [
              "get_product"
            ],
            "toolArgs": {
              "get_product": {
                "productId": {
                  "$eq": "p01"
                }
              }
            },
            "replyContains": [
              "299"
            ]
          }
        }
      ]
    },
    {
      "id": "c14",
      "group": "9.4",
      "title": "指定数量加购",
      "purpose": "“要 2 件”必须把数量传给 add_to_cart，购物车小计按 129×2 计算。",
      "tags": [
        "write"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "把黄铜签字笔加入购物车，要2件",
          "expect": {
            "tools": [
              "add_to_cart"
            ],
            "toolArgs": {
              "add_to_cart": {
                "productId": {
                  "$eq": "p16"
                },
                "quantity": {
                  "$eq": 2
                }
              }
            },
            "cart": {
              "quantity": 2,
              "amount": 258,
              "items": [
                {
                  "productId": "p16",
                  "quantity": 2
                }
              ]
            },
            "replyContains": [
              "黄铜签字笔",
              "258"
            ]
          }
        }
      ]
    },
    {
      "id": "c15",
      "group": "9.4",
      "title": "下单确认、订单号与查单",
      "purpose": "加购后“下单”只生成待确认动作；确认后创建订单并返回合法订单号，随后可按订单号查询。",
      "tags": [
        "write",
        "confirmation"
      ],
      "steps": [
        {
          "type": "register",
          "usernamePrefix": "evalc15",
          "expect": {
            "httpStatus": 201
          }
        },
        {
          "type": "chat",
          "message": "把听风 Air One 真无线运动耳机加入购物车",
          "expect": {
            "tools": [
              "add_to_cart"
            ],
            "toolArgs": {
              "add_to_cart": {
                "productId": {
                  "$eq": "p01"
                },
                "quantity": {
                  "$eq": 1
                }
              }
            },
            "cart": {
              "quantity": 1,
              "amount": 299,
              "items": [
                {
                  "productId": "p01",
                  "quantity": 1
                }
              ]
            }
          }
        },
        {
          "type": "chat",
          "message": "下单",
          "expect": {
            "tools": [
              "create_order"
            ],
            "action": {
              "event": true,
              "status": "pending",
              "type": "create_order",
              "amount": 299
            },
            "replyContains": [
              "299"
            ]
          }
        },
        {
          "type": "confirm",
          "approved": true,
          "receiver": {
            "name": "评测用户",
            "phone": "13800138000",
            "address": "上海市评测路 1 号"
          },
          "expect": {
            "httpStatus": 200,
            "cancelled": false,
            "orderIdRegex": "^XM\\d{8}[A-F0-9]{6}$",
            "orderTotal": 299,
            "orderStatus": "pending"
          }
        },
        {
          "type": "chat",
          "message": "查一下订单 {{orderId}}",
          "expect": {
            "tools": [
              "get_order"
            ],
            "toolArgs": {
              "get_order": {
                "orderId": {
                  "$eq": "{{orderId}}"
                }
              }
            },
            "replyContains": [
              "{{orderId}}",
              "待支付"
            ]
          }
        }
      ]
    },
    {
      "id": "c16",
      "group": "9.4",
      "title": "取消确认保留购物车",
      "purpose": "用户在确认框点取消后不能创建订单，购物车商品必须保留。",
      "tags": [
        "write",
        "confirmation"
      ],
      "steps": [
        {
          "type": "register",
          "usernamePrefix": "evalc16",
          "expect": {
            "httpStatus": 201
          }
        },
        {
          "type": "chat",
          "message": "把砚白 手作陶瓷马克杯加入购物车",
          "expect": {
            "tools": [
              "add_to_cart"
            ],
            "toolArgs": {
              "add_to_cart": {
                "productId": {
                  "$eq": "p11"
                },
                "quantity": {
                  "$eq": 1
                }
              }
            },
            "cart": {
              "quantity": 1,
              "amount": 69,
              "items": [
                {
                  "productId": "p11",
                  "quantity": 1
                }
              ]
            }
          }
        },
        {
          "type": "chat",
          "message": "下单",
          "expect": {
            "tools": [
              "create_order"
            ],
            "action": {
              "event": true,
              "status": "pending",
              "type": "create_order",
              "amount": 69
            }
          }
        },
        {
          "type": "confirm",
          "approved": false,
          "expect": {
            "httpStatus": 200,
            "cancelled": true,
            "noOrder": true
          }
        },
        {
          "type": "chat",
          "message": "购物车里有什么",
          "expect": {
            "tools": [
              "view_cart"
            ],
            "cart": {
              "quantity": 1,
              "amount": 69,
              "items": [
                {
                  "productId": "p11",
                  "quantity": 1
                }
              ]
            },
            "replyContains": [
              "马克杯",
              "69"
            ]
          }
        }
      ]
    },
    {
      "id": "c17",
      "group": "9.4",
      "title": "售罄商品加购失败",
      "purpose": "库存为 0 的商品必须拒绝加购，清楚说明原因，且不能发出购物车更新事件。",
      "tags": [
        "write",
        "exception"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "把雪松香薰蜡烛加入购物车",
          "expect": {
            "tools": [
              "add_to_cart"
            ],
            "toolArgs": {
              "add_to_cart": {
                "productId": {
                  "$eq": "p12"
                },
                "quantity": {
                  "$eq": 1
                }
              }
            },
            "noCartEvent": true,
            "noActionEvent": true,
            "replyContains": [
              "售罄"
            ]
          }
        }
      ]
    },
    {
      "id": "c18",
      "group": "9.5",
      "title": "搜索后按序号加购",
      "purpose": "一句话里的两个动作按顺序执行：先搜索耳机，再把第一件 p01 加购。",
      "tags": [
        "planning",
        "write"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "找耳机，然后把第一个加进购物车",
          "expect": {
            "tools": [
              "search_products",
              "add_to_cart"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "耳机"
                }
              },
              "add_to_cart": {
                "productId": {
                  "$eq": "p01"
                },
                "quantity": {
                  "$eq": 1
                }
              }
            },
            "cart": {
              "quantity": 1,
              "amount": 299,
              "items": [
                {
                  "productId": "p01",
                  "quantity": 1
                }
              ]
            },
            "replyContains": [
              "299"
            ]
          }
        }
      ]
    },
    {
      "id": "c19",
      "group": "9.5",
      "title": "搜索加购再下单",
      "purpose": "三步指令要按顺序规划：搜索键盘、加购第二件 p06、生成待确认下单动作。",
      "tags": [
        "planning",
        "write",
        "confirmation"
      ],
      "steps": [
        {
          "type": "chat",
          "message": "找500元以内的键盘，然后把第二个加进购物车，再下单",
          "expect": {
            "tools": [
              "search_products",
              "add_to_cart",
              "create_order"
            ],
            "toolArgs": {
              "search_products": {
                "keyword": {
                  "$includes": "键盘"
                },
                "maxPrice": {
                  "$eq": 500
                }
              },
              "add_to_cart": {
                "productId": {
                  "$eq": "p06"
                },
                "quantity": {
                  "$eq": 1
                }
